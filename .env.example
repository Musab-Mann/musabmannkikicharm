# ------------------------------------------------------------------
# KKCHARM — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values before launch.
# Never commit .env.local.
# ------------------------------------------------------------------

# --- Supabase (REQUIRED — this is the production database and file
# storage; there is no local-filesystem fallback) ------------------
#   1. Create a project at https://supabase.com
#   2. Run every file in /supabase/migrations, in order, in the SQL editor
#      (supabase/schema.sql first if you have not already, then the
#      numbered migrations)
#   3. Fill in the values below from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin authentication secrets (REQUIRED in production) --------
# Each MUST be a 64-character hex string (32 random bytes).
# Generate with:  openssl rand -hex 32
# These are NOT admin passwords — admin accounts now live in the
# database (see: npm run setup:admin).
# ADMIN_SESSION_SECRET signs admin session cookies and is required.
# ADMIN_MFA_ENCRYPTION_KEY is a leftover from the old Google
# Authenticator/TOTP-based login, which has been removed entirely (login
# now uses username + password + a 6-digit code emailed to the admin's
# security email, plus recovery codes for account recovery). Nothing in
# the app calls the encryption functions that used this key anymore, so
# it is no longer required — safe to leave set (harmless) or remove.
ADMIN_SESSION_SECRET=
ADMIN_MFA_ENCRYPTION_KEY=

# --- Email (optional until you're ready to send real emails) ------
# Get an API key from https://resend.com (or SendGrid, if you change
# lib/email.ts's provider). Without these, order/security emails are
# logged to the server console instead of being sent — nothing is faked.
EMAIL_API_KEY=
ADMIN_EMAIL=owner@yourdomain.com
BUSINESS_EMAIL=orders@yourdomain.com

# --- App URL (optional) --------------------------------------------
# Not required by anything currently shipped (the admin password-reset
# flow now uses an emailed one-time code instead of a link, so it no
# longer needs this). Kept here as a place to put your production
# domain if/when a future feature needs to build an absolute URL
# server-side (e.g. a sitemap or an email link).
NEXT_PUBLIC_APP_URL=https://yourdomain.com
